{
  "name": "vin-fleet-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "format": "prettier --check .",
    "test": "npm run test:db:up --silent && vitest run",
    "geocode:reaudit": "tsx scripts/regeocode-audit.mts",
    "test:db:up": "scripts/test-db.sh up",
    "test:db:down": "scripts/test-db.sh down",
    "test:db:migrate": "tsx scripts/test-db-migrate.mts",
    "test:db:reset": "scripts/test-db.sh reset && npm run test:db:migrate",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "preflight": "tsx scripts/preflight-pooler.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:verify": "tsx scripts/verify-db.mts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.mts",
    "db:explain": "tsx scripts/explain-fleet.mts",
    "worker": "tsx src/worker/index.ts",
    "samsara:probe": "tsx scripts/samsara-probe.mts",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky",
    "seed:demo": "tsx scripts/seed-demo.mts",
    "geocode:backfill": "tsx scripts/geocode-backfill.mts",
    "check:truck": "tsx scripts/check-truck.mts",
    "demo:relocate": "tsx scripts/relocate-demo-stops.mts",
    "geocode:probe": "tsx scripts/geocode-probe.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.14.13",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.6",
    "mapbox-gl": "^3.30.0",
    "next": "^15.5.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.1.3",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^9.1.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
