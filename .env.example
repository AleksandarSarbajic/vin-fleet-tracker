# ---------------------------------------------------------------------------
# LOCAL ONLY — never commit. Covered by .gitignore (.env.local).
# Mirror any change into .env.example as a NAME ONLY, never a value.
# ---------------------------------------------------------------------------

# --- Supabase: browser-safe -------------------------------------------------
# Bare origin. supabase-js appends /rest/v1 etc. itself.
NEXT_PUBLIC_SUPABASE_URL=https://ywfotpjljshxrgxlgcdp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase: server only. NEVER prefix these NEXT_PUBLIC_ -----------------
# Two separate secret keys so either service can be rotated alone.
SUPABASE_SECRET_KEY=
WORKER_SUPABASE_SECRET_KEY=

# --- Postgres ---------------------------------------------------------------
# DATABASE_URL  = TRANSACTION pooler, port 6543, for Next.js route handlers.
#                 Transaction mode does NOT support prepared statements —
#                 the Drizzle client sets prepare:false. Do not remove that.
DATABASE_URL=

# DIRECT_URL    = SESSION pooler, port 5432, for migrations and the worker.
#                 NOT db.<ref>.supabase.co:5432 — that host is IPv6-only
#                 (verified: no A record, AAAA only) and most worker hosts
#                 have no outbound IPv6. Session mode is a persistent
#                 connection and does support prepared statements.
DIRECT_URL=

# --- Samsara: server only ---------------------------------------------------
# Scopes granted: Read Vehicles, Read Vehicle Statistics, Read Drivers,
# Read Assignments. No HOS. Browsers never call Samsara.
SAMSARA_API_TOKEN=
SAMSARA_ORG_ID=45975

# --- Mapbox -----------------------------------------------------------------
# pk.* tokens are publishable by design. Design assumes dark-v11 tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- App --------------------------------------------------------------------
DISPATCH_TZ=America/Chicago
