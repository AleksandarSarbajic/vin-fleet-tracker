# ---------------------------------------------------------------------------
# LOCAL ONLY — never commit. Covered by .gitignore (.env.local).
# Mirror any change into .env.example as a NAME ONLY, never a value.
# ---------------------------------------------------------------------------

# --- Supabase: browser-safe -------------------------------------------------
# Bare origin. supabase-js appends /rest/v1 etc. itself.
NEXT_PUBLIC_SUPABASE_URL=https://ywfotpjljshxrgxlgcdp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase secret key: OPERATOR SCRIPTS ONLY. Never NEXT_PUBLIC_ ----------
# Read by scripts/e2e-user.mts alone, run from a developer's machine to create
# or rotate the e2e account. The app and the worker hold NO secret key
# (§12.75): never set this in Vercel, never on the droplet.
SUPABASE_SECRET_KEY=

# --- Postgres ---------------------------------------------------------------
# DATABASE_URL  = TRANSACTION pooler, port 6543, for Next.js route handlers.
#                 Transaction mode does NOT support prepared statements —
#                 the Drizzle client sets prepare:false. Do not remove that.
DATABASE_URL=

# DIRECT_URL    = SESSION pooler, port 5432, for migrations and the worker.
#                 NOT db.<ref>.supabase.co:5432 — that host is IPv6-only
#                 (verified: no A record, AAAA only) and most worker hosts
#                 have no outbound IPv6. Session mode is a persistent
#                 connection and does support prepared statements.
DIRECT_URL=

# --- Samsara: server only ---------------------------------------------------
# Scopes granted: Read Vehicles, Read Vehicle Statistics, Read Drivers,
# Read Assignments. No HOS. Browsers never call Samsara.
SAMSARA_API_TOKEN=
SAMSARA_ORG_ID=45975

# --- Mapbox (map tiles only) -------------------------------------------------
# pk.* tokens are publishable by design. Design assumes dark-v11 tiles.
# Routing left Mapbox in §12.59; this token draws the map and nothing else.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- HERE (routing) ----------------------------------------------------------
# HERE Routing v8, transportMode=truck (§12.59). SERVER ONLY — never a
# NEXT_PUBLIC_* name: routing is metered and the Base free allowance is 5,000
# transactions a month. Startup refuses a key that also appears in any
# NEXT_PUBLIC_* variable.
#
# Optional. Without it every lane falls back to the lane-ratio estimate or the
# straight line, exactly as it does when the provider is down.
#
# Geocoding stays on the US Census geocoder and is NOT part of this key:
# HERE's Base plan states that Permanent Geocoding is not included, and we
# store coordinates long-term.
HERE_API_KEY=

# Monthly routing ceiling. Default 5,000 -- HERE's free Base allowance exactly.
# A real dispatch day costs 168 calls (187 simulated), so the current recompute
# rule projects ~5,800/month and does not fit inside any honest ceiling. 5,000
# is where the guard can still do something: above it, HERE's own limit arrives
# first and the overage is a bill. See §12.61.
ROUTING_MONTHLY_CEILING=5000

# --- Sentry -----------------------------------------------------------------
# TWO SEPARATE PROJECTS. The app and the worker are different runtimes with
# different failure modes, and one DSN in both variables silently merges their
# streams and their quotas -- startup refuses identical values.
#
# A DSN is NOT a secret: it is write-only ingest, which is why the app's is a
# NEXT_PUBLIC_ name and reaches the browser by design. This is the one
# deliberate exception in this file.
#
# Both optional. Absent, the runtime starts and reports nothing, for the same
# reason HERE_API_KEY is optional: observability must not be able to take the
# console or the worker off the air.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_WORKER_DSN=

# Usually the deployed commit, so an event can name the code it came from.
SENTRY_RELEASE=

# SOURCE MAPS, build-time only. Without these a production stack trace is
# minified to `a.b is not a function` and the report is barely worth having.
# Not needed to RUN anything -- only to build the Next app with uploads on.
# The auth token is a real secret, unlike the DSNs above.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# SENTRY_DEBUG=1 turns on transport logging in any runtime, so "is it actually
# reporting?" is answerable on a host you cannot attach a debugger to.
# Hundreds of lines per event -- leave unset unless you are asking that.
SENTRY_DEBUG=

# --- End-to-end tests (Playwright) ------------------------------------------
# A DEDICATED Supabase account, never a real person's. Auth is hosted, so the
# e2e suite uses a REAL session against a LOCAL, disposable database: the login
# flow and the middleware redirect are genuinely exercised, while every row the
# tests touch lives in ./.testdb and is thrown away.
#
# scripts/e2e-user.mts creates or rotates the account and prints the values.
E2E_EMAIL=
E2E_PASSWORD=
E2E_USER_ID=

# --- App --------------------------------------------------------------------
DISPATCH_TZ=America/Chicago
